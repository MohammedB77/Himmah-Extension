{
  "manifest_version": 3,

  "name": "Himmah",

  "version": "1.0",

  "permissions": [
    "storage"
  ],

  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/*"
      ],

      "js": [
        "script.js"
      ],

      "css": [
        "style.css"
      ]
    }
  ]
}